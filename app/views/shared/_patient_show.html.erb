<%= turbo_frame_tag "modal" do %>
  <div id="modal" class="fixed inset-0 z-50 overflow-y-auto backdrop-blur-md bg-opacity-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-start justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">

      <div class="inline-block align-bottom bg-primary-bg rounded-3xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full">
        <div class="p-6 lg:p-8 bg-card-bg">

          <div class="flex justify-end">
            <%= link_to "#", data: { controller: "modals", action: "modals#close" }, class: "text-secondary-text hover:text-red-500 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            <% end %>
          </div>

          <div class="space-y-6">
            <div class="sm:flex sm:items-center sm:justify-between border-b border-primary-border pb-4 mb-4">
              <div class="sm:flex-auto">
                <h1 id="modal-title" class="text-3xl font-bold leading-tight tracking-tight text-secondary-text">
                  <%= patient.first_name %> <%= patient.last_name %>
                </h1>
                <p class="mt-1 text-lg text-accent-1 font-medium"><%= patient.department %> Department</p>
              </div>
              <% if defined?(edit_path) && edit_path.present? %>
                <div class="mt-4 sm:ml-16 sm:mt-0 flex space-x-3">
                  <%= link_to "Edit", edit_path, data: { turbo_frame: "modal" }, class: "inline-flex items-center rounded-xl border border-transparent bg-accent-1 px-3 py-2 text-sm font-medium text-primary-text shadow-lg hover:bg-accent-1-hover focus:outline-none focus:ring-2 focus:ring-accent-1 focus:ring-offset-2 transition duration-200" %>
                </div>
              <% end %>
            </div>

            <div class="bg-card-bg overflow-hidden rounded-3xl">
              <div class="divide-y divide-primary-border">
                <div class="px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 bg-secondary-bg/20">
                  <dt class="text-lg font-semibold text-accent-1 sm:col-span-3">User & Affiliation</dt>
                </div>

                <div class="px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                  <dt class="text-sm font-medium text-secondary-text">Email</dt>
                  <dd class="mt-1 text-sm text-secondary-text sm:col-span-2 sm:mt-0"><%= patient.email %></dd>
                </div>

                <div class="px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                  <dt class="text-sm font-medium text-secondary-text">Organization</dt>
                  <dd class="mt-1 text-sm text-secondary-text sm:col-span-2 sm:mt-0"><%= patient.organization&.name || "N/A" %></dd>
                </div>

                <div class="px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 bg-secondary-bg/20">
                  <dt class="text-lg font-semibold text-accent-1 sm:col-span-3">Contact Details</dt>
                </div>

                <div class="px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                  <dt class="text-sm font-medium text-secondary-text">Phone</dt>
                  <dd class="mt-1 text-sm text-secondary-text sm:col-span-2 sm:mt-0"><%= patient.phone %></dd>
                </div>

                <div class="px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                  <dt class="text-sm font-medium text-secondary-text">Full Name</dt>
                  <dd class="mt-1 text-sm text-secondary-text sm:col-span-2 sm:mt-0"><%= patient.first_name %> <%= patient.last_name %></dd>
                </div>

              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
<% end %>
