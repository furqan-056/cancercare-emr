<div id="<%= dom_id(slot) %>" class="bg-accent-1 text-white text-sm rounded p-2 mb-1 shadow-sm">
  <strong><%= current_user.first_name %></strong>
  <br>
  <%= slot.start_time.strftime("%I:%M %p") %> - <%= slot.end_time.strftime("%I:%M %p") %>
  <div class="mt-1 flex items-center space-x-2">
    <%= link_to edit_doctors_slot_path(slot), data: { turbo_frame: "modal" }, class: "text-accent-3 text-xs hover:underline font-medium flex items-center" do %>
      <i class="fa-solid fa-pen-to-square mr-1"></i>
    <% end %>

    <%= button_to doctors_slot_path(slot), method: :delete, form: { "data-turbo-frame": "_top", class: "inline-flex items-center" }, data: { turbo_confirm: "Are you sure you want to delete this slot?" }, class: "text-logout-button text-xs hover:bg-logout-hover px-1 rounded font-medium flex items-center" do %>
      <i class="fa-solid fa-trash mr-1"></i>
    <% end %>
  </div>
</div>
