<h1>New Appointment Requested</h1>
<p>Hello <%= @doctor.full_name %>,</p>
<p>An appointment has been requested with <%= @patient.full_name %>.</p>
<p>
  Date & Time: <%= @appointment.slot&.start_time&.strftime("%B %d, %Y at %I:%M %p") || "Not assigned" %><br>
  Status: <%= @appointment.status.humanize %>
</p>
