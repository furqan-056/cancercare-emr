<%= turbo_frame_tag "modal" do %>
  <div class = "modal" ></div>
    <div class="p-4 sm:p-6 lg:p-8">
      <div class="sm:flex sm:items-center sm:justify-between border-b border-primary-border pb-4 mb-8">
        <div class="sm:flex-auto">
          <h1 class="text-3xl font-bold leading-tight tracking-tight text-secondary-text">New Organization</h1>
        </div>
        <div class="mt-4 sm:ml-16 sm:mt-0 flex space-x-3">
          <%= link_to "Cancel", "#", data: {
            controller: "modals",
            action: "modals#close"
          }, class: "cancel-button inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
        </div>
      </div>
      <%= render "form", organization: @organization %>
    </div>
  </div>
<% end %>
