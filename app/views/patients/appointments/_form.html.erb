<div data-controller="calendar"
     data-calendar-doctor-id-value="<%= doctor.id %>"
     data-calendar-holidays-value="<%= exceptions[:holidays].join(',') %>"
     data-calendar-blocked-value="<%= exceptions[:doctor_blocked].join(',') %>"
     class="animate-slide-in-right">

  <h2 class="text-xl font-bold text-primary-text mb-4">
     Book Appointment with <span class="text-accent-1">Dr. <%= @doctor.full_name %></span>
  </h2>

  <% if appointment.persisted? %>
    <div class="flex justify-end mb-4">
      <a href="#"
        data-action="modal#close"
        class="text-secondary-text hover:text-red-500 transition">
        Close
      </a>
    </div>
  <% end %>

  <div class="flex flex-col lg:flex-row gap-6">
    <div class="lg:w-1/2 border border-primary-border p-6 rounded-xl shadow-lg bg-secondary-bg transition-all duration-300 lg:h-fit">
      <div class="flex justify-between items-center mb-6">
        <button type="button" data-action="click->calendar#prevMonth" class="p-2 rounded-full hover:bg-hover-bg text-primary-text transition-colors duration-200 border border-primary-border shadow-sm">
          <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="flex gap-2 text-xl font-bold text-primary-text tracking-wide">
          <span data-calendar-target="month"></span>
          <span data-calendar-target="year"></span>
        </div>

        <button type="button" data-action="click->calendar#nextMonth" class="p-2 rounded-full hover:bg-hover-bg text-primary-text transition-colors duration-200 border border-primary-border shadow-sm">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>

      <div class="grid grid-cols-7 text-center font-bold mb-4 text-secondary-text uppercase text-xs tracking-widest">
        <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
      </div>

      <div data-calendar-target="calendarBody" class="grid grid-cols-7 gap-2 text-black"></div>

      <div class="mt-8 pt-6 border-t border-primary-border grid grid-cols-3 gap-2 text-xs font-medium">
        <div class="flex items-center gap-2 text-secondary-text">
          <div class="w-3 h-3 bg-green-400 rounded-full"></div>
          <span>Available</span>
        </div>
        <div class="flex items-center gap-2 text-secondary-text">
          <div class="w-3 h-3 bg-red-500 rounded-full"></div>
          <span>Holiday</span>
        </div>
        <div class="flex items-center gap-2 text-secondary-text">
          <div class="w-3 h-3 bg-accent-2 rounded-full"></div>
          <span>Unavailable</span>
        </div>
      </div>
    </div>

    <div class="lg:w-1/2 border border-primary-border p-6 rounded-xl shadow-lg bg-secondary-bg transition-all duration-300">
      <h3 class="text-lg font-semibold mb-6 text-primary-text border-b border-primary-border pb-2 tracking-tight">
        Select Date & Time
      </h3>

      <div data-calendar-target="slotsContainer" class="mb-6 min-h-[120px] p-4 rounded-lg bg-primary-bg border border-dashed border-primary-border text-primary-text flex items-center justify-center">
        <% if appointment.appointment_date.present? %>
          <p class="text-secondary-text italic text-sm text-center">Selected date: <%= appointment.appointment_date %></p>
        <% else %>
          <p class="text-secondary-text italic text-sm text-center">Please select a date from the calendar</p>
        <% end %>
      </div>

      <%= form_with(model: appointment, url: form_url, data: { calendar_target: "form" }, class: "space-y-4") do |f| %>

        <% if appointment.errors.any? %>
          <div class="mb-4 p-4 border border-red-400 bg-red-50 text-red-700 rounded-md">
            <h2 class="font-bold mb-2">
              <%= pluralize(appointment.errors.count, "error") %> prevented this appointment from being saved:
            </h2>
            <ul class="list-disc list-inside text-sm">
              <% appointment.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= f.hidden_field :appointment_date, data: { calendar_target: "dateInput" } %>
        <%= f.hidden_field :slot_id, data: { calendar_target: "slotInput" } %>
        <div class="theme-text-field">
          <%= f.label :reason, class: "block font-medium mb-2 text-primary-text" %>
          <%= f.text_area :reason, rows: 4, class: "w-full border border-primary-border rounded-lg p-3 bg-white text-primary-text placeholder-gray-700 focus:ring-2 focus:ring-accent-1 focus:outline-none transition-all duration-200 shadow-inner", placeholder: "Please describe your reason for the appointment..." %>
        </div>
        <%= f.submit appointment.persisted? ? "Update Appointment" : "Book Appointment", class: "w-full bg-accent-1 hover:bg-accent-1-hover text-white py-3 rounded-lg font-bold shadow-lg transform active:scale-[0.98] transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed", data: { calendar_target: "submitBtn" }, disabled: appointment.appointment_date.blank? %>
      <% end %>
    </div>
  </div>
</div>
