<div id="<%= dom_id(slot) %>" class="bg-accent-1 text-white text-sm rounded p-2 mb-1 shadow-sm">
  <strong>
    <%= slot.doctor&.first_name || "Unknown Doctor" %>
  </strong>
  <br>
  <%= slot.start_time.strftime("%I:%M %p") %> - <%= slot.end_time.strftime("%I:%M %p") %>
  <div class="mt-1 flex items-center space-x-2">
    <%= link_to edit_managers_slot_path(slot), data: { turbo_frame: "modal" }, class: "flex items-center text-accent-3 text-xs hover:underline font-medium" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
      </svg>
    <% end %>
    <%= button_to managers_slot_path(slot),
          method: :delete,
          form: { "data-turbo-frame": "_top", class: "inline-flex items-center" },
          data: { turbo_confirm: "Are you sure you want to delete this slot?" },
          class: "text-logout-button text-xs hover:bg-logout-hover px-1 rounded font-medium" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5-4h4m-4 0a1 1 0 00-1 1v1h6V4a1 1 0 00-1-1m-4 0h4" />
      </svg>
    <% end %>
  </div>
</div>
