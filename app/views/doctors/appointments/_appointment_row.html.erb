<tr id="<%= dom_id(appointment) %>" class="hover:bg-hover-bg/10 transition-colors">
  <td class="px-6 py-4 text-sm text-primary-text"><%= appointment.patient.full_name %></td>
  <td class="px-6 py-4 text-sm text-primary-text"><%= appointment.doctor.full_name %></td>
  <td class="px-6 py-4 text-sm text-primary-text"><%= appointment.appointment_date.strftime("%b %d, %Y") %></td>
  <td class="px-6 py-4 text-sm text-secondary-text"><%= appointment.slot&.display_name || "No Slot" %></td>
  <td class="px-6 py-4 text-sm">
    <% meta = appointment_status_meta(appointment.status) %>
    <span class="px-2 py-1 text-[10px] font-black rounded-full border uppercase tracking-tighter <%= meta[:classes] %>">
      <i class="fa-solid <%= meta[:icon] %>"></i>
      <%= appointment.status.titleize %>
    </span>
  </td>
  <td class="px-6 py-4 text-center text-sm flex justify-center gap-2">

    <%= link_to doctors_appointment_path(appointment), data: { turbo_frame: "modal" }, class: "text-blue-500 hover:text-blue-400 px-3 py-1 rounded-lg transition" do %>
      <i class="fa-solid fa-eye fa-lg"></i>
    <% end %>

    <%= link_to edit_doctors_appointment_path(appointment), data: { turbo_frame: "appointment_form" }, class: "text-blue-500 hover:text-blue-400 px-3 py-1 rounded-lg transition" do %>
      <i class="fa-solid fa-pen-to-square fa-lg"></i>
    <% end %>

    <%= button_to doctors_appointment_path(appointment), method: :delete, form: { data: { turbo_confirm: "Are you sure you want to delete this appointment?" } }, class: "text-red-500 hover:text-red-400 px-3 py-1 rounded-lg transition" do %>
      <i class="fa-solid fa-trash-can fa-lg"></i>
    <% end %>
  </td>
</tr>
