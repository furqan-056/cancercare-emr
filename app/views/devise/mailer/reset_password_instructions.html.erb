<p>Hello <%= @resource.email %>!</p>
<p>Someone has requested a link to change your password. You can do this through the link below.</p>
<% 
  if @resource.is_a?(User) && @resource.manager? && @resource.organization.present?
    if Rails.env.production?
      reset_url = edit_user_password_url(@resource, reset_password_token: @token, host: "#{@resource.organization.slug}.yourdomain.com")
    else
      reset_url = edit_user_password_url(@resource, reset_password_token: @token, host: "#{@resource.organization.slug}.localhost:3000")
    end
  else
    reset_url = edit_user_password_url(@resource, reset_password_token: @token)
  end
%>
<p><%= link_to 'Change my password', reset_url %></p>
<p>If you didn't request this, please ignore this email.</p>
<p>Your password won't change until you access the link above and create a new one.</p>
