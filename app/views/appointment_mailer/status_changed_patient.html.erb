<h1>Appointment Status Updated</h1>
<p>Hello <%= @patient.full_name %>,</p>
<p>Your appointment with Dr. <%= @doctor.full_name %> has changed status to <%= @appointment.status.humanize %>.</p>
<p>
  Date & Time: <%= @appointment.slot&.start_time&.strftime("%B %d, %Y at %I:%M %p") || "Not assigned" %>
</p>
