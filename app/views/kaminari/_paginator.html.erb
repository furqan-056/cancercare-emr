<%= paginator.render do -%>
  <nav class="flex justify-center" aria-label="Pagination">
    <ul class="inline-flex items-center space-x-2 text-secondary-text">
      <%= first_page_tag %>
      <%= prev_page_tag %>
      <% each_page do |page| -%>
        <% if page.display_tag? -%>
          <%= page_tag page %>
        <% elsif !page.was_truncated? -%>
          <%= gap_tag %>
        <% end -%>
      <% end -%>
      <% unless current_page.out_of_range? %>
        <%= next_page_tag %>
        <%= last_page_tag %>
      <% end %>
    </ul>
  </nav>
<% end -%>
