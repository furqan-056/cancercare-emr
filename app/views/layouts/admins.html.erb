<!DOCTYPE html>
<html>
  <head>
    <title>CancerCare EMR Admin</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-900 text-white"> 
    <div data-controller="sidebar" class="flex h-screen bg-gray-900">
      <div data-sidebar-target="container" class="flex flex-col w-64 bg-gray-800 rounded-r-2xl shadow-2xl border border-gray-700 transition-all duration-300">
        <div class="flex items-center justify-between p-6 border-b border-gray-700">
          <h2 data-sidebar-target="title" class="text-lg font-bold text-white">Admin Menu</h2>
          <button data-action="click->sidebar#toggle" class="text-gray-400 focus:outline-none">
            <svg data-sidebar-target="closeIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <svg data-sidebar-target="openIcon" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>

        <nav class="flex-1 p-6">
          <ul class="space-y-4">
            <li>
              <%= link_to admins_organizations_path, class: "flex items-center p-3 text-white hover:bg-gray-700 rounded-xl transition duration-200" do %>
                <svg class="h-6 w-6 text-white flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a2 2 0 012-2h2a2 2 0 012 2v5" />
                </svg>
                <span data-sidebar-target="label" class="ml-3">Organizations</span>
              <% end %>
            </li>
          </ul>
        </nav>
      </div>

      <div class="flex-1 flex flex-col bg-gray-900">
        <header class="flex items-center justify-between bg-gray-800 border-b border-gray-700 p-6 shadow-lg rounded-b-3xl">
          <h1 class="text-2xl font-bold text-white">CancerCare EMR Admin Dashboard</h1>
          <div class="flex items-center space-x-4">
            <button data-controller="theme-toggle"
                    data-action="click->theme-toggle#toggle"
                    class="p-2 text-gray-400 bg-gray-700 rounded-full hover:text-white hover:bg-gray-600 transition duration-200 focus:outline-none">
              <svg data-theme-toggle-target="moonIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
              <svg data-theme-toggle-target="sunIcon" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </button>
            <%= button_to 'Logout', destroy_admin_session_path, method: :delete, class: 'px-4 py-2 bg-red-600 text-white font-semibold rounded-xl hover:bg-red-700 transition duration-200' %>
          </div>
        </header>
        <main class="flex-1 overflow-y-auto p-6 text-white">
          <%= render "layouts/flash_messages" %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
