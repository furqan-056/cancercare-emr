<!DOCTYPE html>
<html>
  <head>
    <title>CancerCare EMR Manager</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", type: "module", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <link rel="icon" href="/emr.png" type="image/png">
    <link rel="icon" href="/emr.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
  </head>

  <body class="bg-primary-bg text-primary-text"> 
    <div data-controller="sidebar" class="flex h-screen bg-primary-bg">
      <div data-sidebar-target="container" class="flex flex-col w-64 bg-secondary-bg rounded-r-1xl shadow-2xl border border-primary-border transition-all duration-300">
        <div class="flex items-center justify-between p-6 border-b border-primary-border">
          <h2 data-sidebar-target="title" class="text-lg font-bold text-primary-text">Manager Menu</h2>
          <button data-action="click->sidebar#toggle" class="text-secondary-text focus:outline-none">
            <svg data-sidebar-target="closeIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <svg data-sidebar-target="openIcon" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>

        <nav class="flex-1 p-6" data-controller="active-link">
          <ul class="space-y-4">
            <li>
              <%= link_to managers_dashboard_path, class: "flex items-center p-3 rounded-xl transition duration-200 hover:bg-hover-bg", data: { active_link_target: "link" } do %>
                <svg class="h-6 w-6 text-primary-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0h6" />
                </svg>
                <span data-sidebar-target="label" class="ml-3">Dashboard</span>
              <% end %>
            </li>
            <li>
                <%= link_to managers_doctors_path, class: "flex items-center p-3 rounded-xl transition duration-200 hover:bg-hover-bg", data: { active_link_target: "link" } do %>
                  <svg class="h-6 w-6 text-primary-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                  <span data-sidebar-target="label" class="ml-3">Doctors</span>
                <% end %>
            </li>
            <li>
              <%= link_to managers_patients_path, class: "flex items-center p-3 rounded-xl transition duration-200 hover:bg-hover-bg", data: { active_link_target: "link" } do %>
                <svg class="h-6 w-6 text-primary-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A12.015 12.015 0 0112 15c2.757 0 5.284.902 7.379 2.439M12 12a5 5 0 100-10 5 5 0 000 10zM12 22v-4" />
                </svg>
                <span data-sidebar-target="label" class="ml-3">Patients</span>
              <% end %>
            </li>
          </ul>
        </nav>
      </div>

      <div class="flex-1 flex flex-col bg-primary-bg">
        <header class="flex items-center justify-between bg-secondary-bg border-b border-primary-border p-6 shadow-lg rounded-b-3xl">
          <h1 class="text-2xl font-bold text-primary-text">CancerCare EMR Manager Dashboard</h1>
          <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-3">
              <div class="text-base font-semibold text-primary-text">
                <%= current_user.organization.name if current_user.organization %>
              </div>

              <% if current_user.organization&.logo&.attached? %>
                <%= image_tag current_user.organization.logo.variant(resize_to_limit: [40, 40]), class: "h-10 w-10 rounded-full object-cover border border-primary-border" %>
              <% else %>
                <div class="h-10 w-10 rounded-full bg-gray-300 flex items-center justify-center text-sm text-gray-600 border border-primary-border">N/A</div>
              <% end %>

            </div>
            <button data-controller="theme-toggle" data-action="click->theme-toggle#toggle" class="p-2 text-secondary-text bg-hover-bg rounded-full hover:text-primary-text hover:bg-hover-dark transition duration-200 focus:outline-none">
              <svg data-theme-toggle-target="moonIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
              <svg data-theme-toggle-target="sunIcon" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </button>
            <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: 'px-4 py-2 bg-logout-button text-primary-text font-semibold rounded-xl hover:bg-logout-hover transition duration-200' %>
          </div>
        </header>
        <main class="flex-1 overflow-y-auto p-6 text-main-area-text">
          <%= render "layouts/flash_messages" %>
          <%= yield %>
          <%= turbo_frame_tag "modal" %>
        </main>
      </div>
    </div>
  </body>
</html>
