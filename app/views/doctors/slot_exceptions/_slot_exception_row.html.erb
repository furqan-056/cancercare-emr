<tr id="<%= dom_id(slot_exception) %>" class="hover:bg-secondary-bg/20 transition duration-150">
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">
    <%= slot_exception.exception_date.strftime("%Y-%m-%d") %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">
    <%= slot_exception.exception_type.humanize %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">
    <%= slot_exception.slot&.display_name || "-" %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">
    <%= slot_exception.doctor&.full_name || "-" %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">
    <%= slot_exception.reason.presence || "-" %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium flex justify-end gap-3 mt-2">

    <%= link_to edit_doctors_slot_exception_path(slot_exception), data: { turbo_frame: "modal" }, title: "Edit Exception", class: "text-accent-1 hover:text-accent-1-hover flex items-center" do %>
      <i class="fa-solid fa-pen-to-square fa-lg"></i>
    <% end %>

    <%= button_to doctors_slot_exception_path(slot_exception), method: :delete, form: { "data-turbo-frame": "_top", class: "inline-flex items-center" }, data: { turbo_confirm: "Are you sure you want to delete this exception?" }, title: "Delete Exception", class: "text-red-600 hover:text-red-800 flex items-center bg-transparent border-0 p-0" do %>
      <i class="fa-solid fa-trash fa-lg"></i>
    <% end %>

  </td>
</tr>
