<%= turbo_frame_tag "modal" do %>
  <div id="modal"
       data-controller="modal"
       data-action="click->modal#closeOnOutsideClick"
       class="hidden fixed inset-0 z-50 overflow-y-auto bg-opacity-50 backdrop-blur-md"
       aria-labelledby="modal-title"
       role="dialog"
       aria-modal="true">

    <div class="flex items-start justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="inline-block align-bottom bg-primary-bg rounded-3xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle max-w-lg md:max-w-2xl w-full">
        <div class="p-6 lg:p-8 bg-card-bg theme-text-field">

          <%= form_with(model: [:managers, slot_exception], data: { turbo_frame: "modal" }) do |f| %>
            
            <% if slot_exception.errors.any? %>
              <div class="mb-4 p-4 border border-red-400 bg-red-50 text-red-700 rounded-md">
                <h2 class="font-bold mb-2">
                  <%= pluralize(slot_exception.errors.count, "error") %> prevented this exception from being saved:
                </h2>
                <ul class="list-disc list-inside">
                  <% slot_exception.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="flex justify-end mb-4">
              <a href="#"
                 data-action="modal#close"
                 class="theme-text-field hover:text-red-500 transition">
                <i class="fas fa-times"></i>
              </a>
            </div>

            <div data-controller="slot-exception" class="space-y-6">

              <div>
                <%= f.label :exception_date, "Date", class: "block font-medium text-sm" %>
                <%= f.date_field :exception_date,
                      class: "mt-1 block w-full rounded-xl border border-primary-border p-3 shadow-sm text-sm focus:ring-accent-1 focus:border-accent-1",
                      data: { action: "change->slot-exception#updateSlots", slot_exception_target: "date" } %>
              </div>

              <div>
                <%= f.label :exception_type, "Exception Type", class: "block font-medium text-sm" %>
                <%= f.select :exception_type,
                    SlotException.exception_types.keys.map { |k| [k.humanize, k] },
                    { prompt: "Select Type" },
                    class: "mt-1 block w-full rounded-xl border border-primary-border p-3 shadow-sm text-sm focus:ring-accent-1 focus:border-accent-1" %>

                <div class="mt-2 text-sm text-gray-600">
                  <p>
                    <strong>Guidelines:</strong><br>
                    Global Holiday → leave both Doctor and Slot blank<br>
                    Block Specific Slot → select a Slot, leave Doctor blank<br>
                    Block All Slots of Doctor → select a Doctor, leave Slot blank
                  </p>
                </div>
              </div>

              <div>
                <%= f.label :doctor_id, "Doctor (optional)", class: "block font-medium text-sm" %>
                <select name="slot_exception[doctor_id]" id="slot_exception_doctor_id"
                        class="mt-1 block w-full rounded-xl border border-primary-border p-3 shadow-sm text-sm focus:ring-accent-1 focus:border-accent-1"
                        data-slot-exception-target="doctor">
                  <option value="">-- None --</option>
                  <% User.doctor.each do |d| %>
                    <option value="<%= d.id %>" <%= "selected" if slot_exception.doctor_id == d.id %>>
                      <%= d.full_name %>
                    </option>
                  <% end %>
                </select>
              </div>

              <div>
                <%= f.label :slot_id, "Specific Slot (optional)", class: "block font-medium text-sm" %>
                <select name="slot_exception[slot_id]" id="slot_exception_slot_id"
                        class="mt-1 block w-full rounded-xl border border-primary-border p-3 shadow-sm text-sm focus:ring-accent-1 focus:border-accent-1"
                        data-slot-exception-target="slot">
                  <option value="">-- None --</option>
                  <% Slot.all.each do |s| %>
                    <option value="<%= s.id %>" 
                            data-weekday="<%= s.weekday_before_type_cast %>"
                            data-doctor-id="<%= s.doctor_id %>"
                            <%= "selected" if slot_exception.slot_id == s.id %>>
                      <%= s.display_name %>
                    </option>
                  <% end %>
                </select>
              </div>

              <div>
                <%= f.label :reason, "Reason", class: "block font-medium text-sm" %>
                <%= f.text_field :reason, class: "mt-1 block w-full rounded-xl border border-primary-border p-3 shadow-sm text-sm focus:ring-accent-1 focus:border-accent-1" %>
              </div>

              <div class="flex justify-end space-x-3 pt-4">
                <%= f.submit slot_exception.persisted? ? "Update Exception" : "Create Exception",
                      class: "bg-accent-1 hover:bg-accent-1-hover text-white px-6 py-2 rounded-xl shadow-md transition duration-200" %>
              </div>

            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
<% end %>
