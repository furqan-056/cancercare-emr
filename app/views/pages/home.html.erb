<nav class="bg-blue-800 p-4 shadow-lg sticky top-0 z-30">
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    <%= link_to "CancerCare EMR", root_path, class: "text-2xl font-bold text-white tracking-wider" %>

    <div class="relative">
      <input type="checkbox" id="login-toggle" class="hidden peer">

      <label for="login-toggle" 
             class="bg-pink-500 hover:bg-pink-600 text-white font-semibold py-2 px-6 rounded-full transition duration-300 ease-in-out transform hover:scale-105 shadow-md flex items-center cursor-pointer">
        Login
        <svg class="ml-2 -mr-1 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </label>
      <div class="absolute right-0 mt-2 w-48 rounded-lg shadow-xl bg-white ring-1 ring-black ring-opacity-5 origin-top-right z-50 
                  hidden peer-checked:block">
        <div class="py-1" role="menu" aria-orientation="vertical" aria-labelledby="options-menu">

          <% if request.subdomain == "admin" %>
            <!-- Admin subdomain -->
            <%= link_to "Login as Admin", new_admin_session_path, 
                class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-pink-500 w-full text-left transition duration-150" %>
          <% elsif request.subdomain.present? && request.subdomain != "www" %>
            <!-- Organization subdomain -->
            <%= link_to "Login as User", new_user_session_url(host: "#{request.subdomain}.localhost", allow_other_host: true), 
                class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-pink-500 w-full text-left transition duration-150" %>
          <% else %>
            <!-- Main homepage -->
            <%= link_to "Login as Admin", new_admin_session_path, 
                class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-pink-500 w-full text-left transition duration-150" %>
            <%= link_to "Login as User", new_user_session_path, 
                class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-pink-500 w-full text-left transition duration-150" %>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</nav>

<section class="w-full max-w-7xl mx-auto mt-4 px-4 overflow-hidden rounded-xl shadow-xl h-80 md:h-96"
        data-controller="carousel"
        data-carousel-interval-value="5000"
        data-carousel-target="container">
  <div class="relative w-full h-full">

    <div data-carousel-target="slide"
        class="absolute inset-0 opacity-100 transition-opacity duration-700 overflow-hidden rounded-xl">
      <img src="<%= asset_path 'carousel_2.jpg' %>" class="absolute inset-0 w-full h-full object-cover" alt="carousel-image-1">
      <div class="absolute inset-x-0 bottom-0 h-full flex items-end justify-center p-6 rounded-b-xl bg-gradient-to-t from-black/70 to-transparent">
        <div class="text-center w-full">
          <h2 class="text-2xl md:text-3xl font-bold text-white">Comprehensive Patient Records</h2>
          <p class="hidden sm:block text-base mt-1 text-gray-200">Streamline your workflow with dedicated cancer care EMR.</p>
        </div>
      </div>
    </div>

    <div data-carousel-target="slide"
        class="absolute inset-0 opacity-0 transition-opacity duration-700 overflow-hidden rounded-xl">
      <img src="<%= asset_path 'carousel_1.jpg' %>" class="absolute inset-0 w-full h-full object-cover" alt="carousel-image-2">
      <div class="absolute inset-x-0 bottom-0 h-full flex items-end justify-center p-6 rounded-b-xl bg-gradient-to-t from-black/70 to-transparent">
        <div class="text-center w-full">
          <h2 class="text-2xl md:text-3xl font-bold text-white">Real-Time Data Insights</h2>
          <p class="hidden sm:block text-base mt-1 text-gray-200">Make informed decisions with powerful analytics and reporting.</p>
        </div>
      </div>
    </div>

    <div data-carousel-target="slide"
        class="absolute inset-0 opacity-0 transition-opacity duration-700 overflow-hidden rounded-xl">
      <img src="<%= asset_path 'carousel_2.jpg' %>" class="absolute inset-0 w-full h-full object-cover" alt="carousel-image-3">
      <div class="absolute inset-x-0 bottom-0 h-full flex items-end justify-center p-6 rounded-b-xl bg-gradient-to-t from-black/70 to-transparent">
        <div class="text-center w-full">
          <h2 class="text-2xl md:text-3xl font-bold text-white">Secure and Compliant</h2>
          <p class="hidden sm:block text-base mt-1 text-gray-200">Protect patient data with industry-leading security standards.</p>
        </div>
      </div>
    </div>

    <button data-action="click->carousel#prev"
            class="absolute top-1/2 left-4 -translate-y-1/2 bg-black/50 hover:bg-black/75 text-white p-2 rounded-full z-20">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <button data-action="click->carousel#next"
            class="absolute top-1/2 right-4 -translate-y-1/2 bg-black/50 hover:bg-black/75 text-white p-2 rounded-full z-20">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <div data-carousel-target="dots" class="absolute bottom-4 left-1/2 -translate-x-1/2 flex space-x-2 z-20">
      <span data-index="0" data-action="click->carousel#show"
            class="w-3 h-3 bg-white rounded-full cursor-pointer opacity-100 ring-2 ring-pink-500"></span>
      <span data-index="1" data-action="click->carousel#show"
            class="w-3 h-3 bg-white rounded-full cursor-pointer opacity-50"></span>
      <span data-index="2" data-action="click->carousel#show"
            class="w-3 h-3 bg-white rounded-full cursor-pointer opacity-50"></span>
    </div>

  </div>
</section>

<main class="flex-grow p-8 bg-gray-50">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-3xl font-extrabold text-blue-900 mb-8 text-center">Understanding Cancer's Impact</h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      
      <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-red-500 transition duration-300 hover:shadow-2xl">
        <h3 class="text-xl font-bold text-red-700 mb-3">Lung Cancer</h3>
        <p class="text-gray-600 text-sm">
          Impacts respiratory function, leading to chronic coughing, difficulty breathing, and systemic fatigue due to reduced oxygenation and spread through lymphatics.
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-pink-500 transition duration-300 hover:shadow-2xl">
        <h3 class="text-xl font-bold text-pink-700 mb-3">Breast Cancer</h3>
        <p class="text-gray-600 text-sm">
          Affects the lymphatic system and hormone regulation, often requiring surgical intervention (lumpectomy/mastectomy) and targeted hormone therapies.
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-green-500 transition duration-300 hover:shadow-2xl">
        <h3 class="text-xl font-bold text-green-700 mb-3">Colorectal Cancer</h3>
        <p class="text-gray-600 text-sm">
          Disrupts the digestive system, causing chronic changes in bowel habits, abdominal pain, and potential blockages or internal bleeding if not detected early.
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-blue-500 transition duration-300 hover:shadow-2xl">
        <h3 class="text-xl font-bold text-blue-700 mb-3">Prostate Cancer</h3>
        <p class="text-gray-600 text-sm">
          Primarily affects the urinary and reproductive systems in men, potentially causing issues with painful or frequent urination, and may metastasize to bones.
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-yellow-500 transition duration-300 hover:shadow-2xl">
        <h3 class="text-xl font-bold text-yellow-700 mb-3">Melanoma</h3>
        <p class="text-gray-600 text-sm">
          Targets the largest organ, the skin, causing uncontrolled growth of pigment-producing cells. It can spread aggressively to vital organs if not excised promptly.
        </p>
      </div>

    </div>
  </div>
</main>

