<h1 class="text-3xl font-bold mb-6 text-secondary-text">My Appointments</h1>

<div class="mb-6">
  <%= search_form_for @q, url: doctors_appointments_path, method: :get, local: false,
        html: {
          data: {
            controller: "live-search",
            live_search_target: "form",
            turbo_frame: "appointments_list"
          },
          class: "flex gap-4 flex-wrap"
        } do |f| %>

    <div class="flex-grow min-w-[200px]">
      <%= f.label :appointment_date_eq, "Filter by Date", class: "block text-sm font-medium text-secondary-text mb-1" %>
      <%= f.date_field :appointment_date_eq, class: "w-fu50ll border border-primary-border rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-accent-1 text-secondary-text", data: { action: "change->live-search#search" } %>
    </div>
  <% end %>
</div>

<%= turbo_frame_tag "appointments_list" do %>
  <div class="overflow-x-auto rounded-xl border border-primary-border shadow bg-card-bg">
    <table class="min-w-full divide-y divide-primary-border">
      <thead class="bg-hover-bg/30">
        <tr class="text-sm font-semibold text-secondary-text uppercase tracking-wide">
          <th class="px-6 py-3 text-left">Patient</th>
          <th class="px-6 py-3 text-left">Doctor</th>
          <th class="px-6 py-3 text-left">Date</th>
          <th class="px-6 py-3 text-left">Slot</th>
          <th class="px-6 py-3 text-left">Status</th>
          <th class="px-6 py-3 text-center">Actions</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-primary-border">
        <% if @appointments.any? %>
          <% @appointments.each do |appt| %>
            <%= render partial: "appointment_row", locals: { appointment: appt } %>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center py-6 text-sm text-secondary-text">
              No appointments found.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @appointments.total_pages > 1 %>
    <div class="mt-4 flex justify-center">
      <%= paginate @appointments, params: { turbo_frame: "appointments_list" } %>
    </div>
  <% end %>
<% end %>

<%= turbo_frame_tag "appointment_form" %>
