<tr id="<%= dom_id(slot_exception) %>" class="hover:bg-secondary-bg/20 transition duration-150">
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">
    <%= slot_exception.exception_date.strftime("%Y-%m-%d") %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">
    <%= slot_exception.exception_type.humanize %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">
    <%= slot_exception.slot&.display_name || "-" %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">
    <%= slot_exception.doctor&.full_name || "-" %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">
    <%= slot_exception.reason.presence || "-" %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium flex justify-end gap-4">

    <%= link_to edit_managers_slot_exception_path(slot_exception), data: { turbo_frame: "modal" }, title: "Edit Exception", class: "text-accent-1 hover:text-accent-1-hover text-lg" do %>
      <i class="fas fa-pen-to-square"></i>
    <% end %>

    <%= link_to managers_slot_exception_path(slot_exception), method: :delete,
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to remove this exception?"
                },
                title: "Delete Exception",
                class: "text-red-600 hover:text-red-800 text-lg" do %>
      <i class="fas fa-trash"></i>
    <% end %>

  </td>
</tr>
