<div class="mb-6 max-w-md mx-auto">
  <div class="flex items-center gap-2 mb-4">
    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
    <h4 class="font-bold text-gray-800 tracking-tight">
      <%= selected_date.strftime('%A, %B %d, %Y') %>
    </h4>
  </div>

  <% if slots.any? %>
    <div class="space-y-3">
      <% slots.each do |slot| %>
        <% 
          slot_blocked = SlotException.where(
            slot_id: slot[:id],
            exception_date: selected_date
          ).exists?
          
          is_available = slot[:available] && !slot_blocked
          
          state_classes = if slot_blocked
                            "bg-orange-50 border-orange-200 text-orange-800 cursor-not-allowed opacity-90"
                          elsif !slot[:available]
                            "bg-red-50 border-red-200 text-red-800 cursor-not-allowed opacity-90"
                          else
                            "bg-white border-green-200 text-green-900 hover:border-green-500 hover:shadow-md cursor-pointer"
                          end
        %>
        
        <button type="button"
                data-action="<%= 'click->calendar#selectSlot' if is_available %>"
                data-slot-id="<%= slot[:id] %>"
                class="w-full text-left p-4 rounded-xl border-2 transition-all duration-200 flex justify-between items-center <%= state_classes %>"
                <%= 'disabled' unless is_available %>>
          
          <div class="flex flex-col">
            <span class="font-bold text-lg"><%= slot[:name] %></span>
            <span class="text-xs opacity-60 uppercase tracking-widest font-semibold">Appointment Slot</span>
          </div>

          <div class="flex items-center">
            <% if slot_blocked %>
              <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-200 text-orange-900 text-[10px] font-black uppercase">
                <span class="w-1.5 h-1.5 rounded-full bg-orange-600 animate-pulse"></span>
                Blocked
              </span>
            <% elsif !slot[:available] %>
              <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-200 text-red-900 text-[10px] font-black uppercase">
                <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
                Booked
              </span>
            <% else %>
              <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-200 text-green-900 text-[10px] font-black uppercase shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                Available
              </span>
            <% end %>
          </div>
        </button>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 px-4 border-2 border-dashed border-gray-200 rounded-2xl bg-gray-50">
      <p class="text-gray-400 font-medium italic">No slots available for this day of the week.</p>
    </div>
  <% end %>
</div>
