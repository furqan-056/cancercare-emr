<% if @appointment.destroyed? %>
  <%= turbo_stream.remove @appointment %>

  <%= turbo_stream.append "flash-container" do %>
    <div
      data-controller="flash"
      class="relative bg-red-500 text-white px-5 py-3 rounded-2xl shadow-lg flex items-center justify-between animate-slide-in-right transition-opacity duration-500">
      <span>Appointment removed successfully!</span>
      <button data-action="click->flash#close" class="ml-4 text-white/80 hover:text-white cursor-pointer">
        <i class="fas fa-times"></i>
      </button>
    </div>
  <% end %>
<% else %>
  <%= turbo_stream.append "flash-container" do %>
    <div
      data-controller="flash"
      class="relative bg-red-500 text-white px-5 py-3 rounded-2xl shadow-lg flex items-center justify-between animate-slide-in-right transition-opacity duration-500">
      <span><%= @appointment.errors.full_messages.to_sentence %></span>
      <button data-action="click->flash#close" class="ml-4 text-white/80 hover:text-white cursor-pointer">
        <i class="fas fa-times"></i>
      </button>
    </div>
  <% end %>
<% end %>
