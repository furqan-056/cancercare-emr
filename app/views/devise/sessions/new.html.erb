<div class="min-h-screen flex items-center justify-center p-4 bg-gray-900">
  <!-- Main Container -->
  <div class="w-full max-w-md">

    <!-- Card Background (Subtle Gradient) -->
    <div class="bg-gray-800 p-8 md:p-10 rounded-3xl shadow-2xl border border-gray-700 backdrop-blur-sm">
      
      <div class="text-center mb-10">
        <h1 class="text-4xl font-extrabold text-white">
          Admin Sign In
        </h1>
        <p class="mt-2 text-gray-400">CancerCare EMR System Access</p>
      </div>
      
      <!-- Devise Form Start -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'space-y-6' }) do |f| %>

        <!-- Error Messages -->
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Email Field -->
        <div class="relative">
          <%= f.email_field :email, 
                            autofocus: true, 
                            autocomplete: "email", 
                            placeholder: "admin@example.com",
                            class: "w-full px-5 py-3 border border-gray-700 rounded-xl bg-gray-900 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition duration-200 shadow-md" %>
          <label for="admin_email" class="sr-only">Email Address</label>
        </div>

        <!-- Password Field -->
        <div class="relative">
          <%= f.password_field :password, 
                                autocomplete: "current-password",
                                placeholder: "Password",
                                class: "w-full px-5 py-3 border border-gray-700 rounded-xl bg-gray-900 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition duration-200 shadow-md" %>
          <label for="admin_password" class="sr-only">Password</label>
        </div>

        <!-- Remember Me Checkbox -->
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <%= f.check_box :remember_me, class: "h-4 w-4 text-indigo-500 border-gray-600 rounded focus:ring-indigo-500 bg-gray-700" %>
              <%= f.label :remember_me, class: "ml-2 block text-sm text-gray-400" %>
            </div>

            <!-- Forgot Password Link -->
            <div class="text-sm">
              <%= link_to "Forgot your password?", new_password_path(resource_name), class: "font-medium text-indigo-400 hover:text-indigo-300 transition duration-200" %>
            </div>
          </div>
        <% end %>

        <!-- Submit Button -->
        <div>
          <%= f.submit "Sign In", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-lg font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer transition duration-300 transform hover:scale-[1.01]" %>
        </div>
      <% end %>
      <!-- Devise Form End -->

      <div class="mt-6 text-center text-sm text-gray-500">
        <p class="text-xs mt-4">Access restricted to authorized administrators.</p>
      </div>
      
    </div>
  </div>
</div>
