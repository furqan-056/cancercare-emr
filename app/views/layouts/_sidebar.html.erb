<div data-sidebar-target="container" class="flex flex-col w-64 bg-secondary-bg rounded-r-1xl shadow-2xl border border-primary-border transition-all duration-300">
  <div class="flex items-center justify-between p-6 border-b border-primary-border">
    <h2 data-sidebar-target="title" class="text-lg font-bold text-primary-text">
      <%= case current_user.role
          when 'patient' then 'Patient Menu'
          when 'doctor' then 'Doctor Menu'
          when 'manager' then 'Manager Menu'
          else 'Menu'
          end %>
    </h2>
    <button data-action="click->sidebar#toggle" class="text-secondary-text focus:outline-none">
      <svg data-sidebar-target="closeIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
      <svg data-sidebar-target="openIcon" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <nav class="flex-1 p-6" data-controller="active-link">
    <ul class="space-y-4">
      <li>
        <%= link_to send("#{current_user.role}s_dashboard_path"), class: "flex items-center p-3 rounded-xl transition duration-200 hover:bg-hover-bg", data: { active_link_target: "link" } do %>
          <svg class="h-6 w-6 text-primary-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0h6" />
          </svg>
          <span data-sidebar-target="label" class="ml-3">Dashboard</span>
        <% end %>
      </li>

      <% if current_user.role == 'manager' %>
        <li>
          <%= link_to managers_doctors_path, class: "flex items-center p-3 rounded-xl transition duration-200 hover:bg-hover-bg", data: { active_link_target: "link" } do %>
            <svg class="h-6 w-6 text-primary-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span data-sidebar-target="label" class="ml-3">Doctors</span>
          <% end %>
        </li>
      <% end %>

      <% if current_user.role == 'manager' || current_user.role == 'doctor' %>
        <li>
          <%= link_to send("#{current_user.role}s_patients_path"), class: "flex items-center p-3 rounded-xl transition duration-200 hover:bg-hover-bg", data: { active_link_target: "link" } do %>
            <svg class="h-6 w-6 text-primary-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A12.015 12.015 0 0112 15c2.757 0 5.284.902 7.379 2.439M12 12a5 5 0 100-10 5 5 0 000 10zM12 22v-4" />
            </svg>
            <span data-sidebar-target="label" class="ml-3">Patients</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
</div>
