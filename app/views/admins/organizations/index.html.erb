<div class="p-4 sm:p-6 lg:p-8">
  <div class="sm:flex sm:items-center border-b border-primary-border pb-4 mb-6">
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-bold leading-tight tracking-tight text-secondary-text">My Organizations</h1>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <%= link_to "New Organization", new_admins_organization_path, data: { turbo_frame: "modal"}, class: "inline-flex items-center justify-center rounded-xl border border-transparent bg-accent-1 px-4 py-2 text-sm font-medium text-primary-text shadow-lg hover:bg-accent-1-hover focus:outline-none focus:ring-2 focus:ring-accent-1 focus:ring-offset-2 transition duration-200" %>
    </div>
  </div>

  <div class="mt-8 flow-root">
    <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
        <div class="overflow-hidden shadow-2xl ring-1 ring-primary-border ring-opacity-5 rounded-3xl">
          <table class="min-w-full divide-y divide-primary-border">
            <thead class="bg-card-bg border-b border-primary-border">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-secondary-text sm:pl-6">Logo</th>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-secondary-text">Name</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Email</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Type</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Phone</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Street</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Location</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">City</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Postal</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Country</th>
                <th scope="col" class="py-3.5 pl-3 pr-4 sm:pr-6 text-sm font-semibold text-secondary-text text-center">Actions</th>
              </tr>
            </thead>

            <%= turbo_frame_tag "organizations_list" do %>
              <tbody class="divide-y divide-primary-border bg-card-bg">
                <% @organizations.each do |org| %>
                  <%= render partial: "organization", locals: { org: org } %>
                <% end %>
                <% if @organizations.empty? %>
                  <tr>
                    <td colspan="11" class="text-center py-6 text-secondary-text">No organizations found.</td>
                  </tr>
                <% end %>
              </tbody>
            <% end %>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
