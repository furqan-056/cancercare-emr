<div class="nested-fields mb-4 p-4 border border-gray-200 rounded-lg">
  <div class="flex justify-between items-center mb-2">
    <h4 class="text-sm font-semibold text-secondary-text">Add Members</h4>
    <%= link_to_remove_association "Remove", f, class: "text-red-500 hover:text-red-700" %>
  </div>

  <div class="space-y-2">
    <%= f.label :email, class: "block text-sm font-medium text-secondary-text" %>
    <%= f.email_field :email, placeholder: "user@example.com", class: "text-secondary-text block w-full rounded-xl border border-primary-border shadow-sm text-sm p-2" %>

    <%= f.label :role, class: "block text-sm font-medium text-secondary-text" %>
    <%= f.select :role, User.roles.keys.map { |r| [r.humanize, r] }, {}, class: "text-secondary-text block w-full rounded-xl border border-primary-border shadow-sm text-sm p-2" %>
  </div>
</div>
