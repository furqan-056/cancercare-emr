<header class="flex items-center justify-between bg-secondary-bg border-b border-primary-border p-6 shadow-lg rounded-b-3xl">
  <h1 class="text-2xl font-bold text-primary-text">
    <% if admin_signed_in? %>
      CancerCare EMR Admin Dashboard
    <% elsif user_signed_in? %>
      <%= case current_user.role
          when 'patient' then 'CancerCare EMR Patient Dashboard'
          when 'doctor' then 'CancerCare EMR Doctor Dashboard'
          when 'manager' then 'CancerCare EMR Manager Dashboard'
          else 'CancerCare EMR Dashboard'
          end %>
    <% end %>
  </h1>
  
  <div class="flex items-center space-x-4">
    <% if user_signed_in? && current_user.organization %>
      <div class="flex items-center space-x-3">
        <div class="text-base font-semibold text-primary-text">
          <%= current_user.organization.name %>
        </div>

        <% if current_user.organization.logo&.attached? %>
          <%= image_tag current_user.organization.logo.variant(resize_to_limit: [40, 40]), class: "h-10 w-10 rounded-full object-cover border border-primary-border" %>
        <% else %>
          <div class="h-10 w-10 rounded-full bg-gray-300 flex items-center justify-center text-sm text-gray-600 border border-primary-border">N/A</div>
        <% end %>
      </div>
    <% end %>

    <button data-controller="theme-toggle" data-action="click->theme-toggle#toggle" class="p-2 text-secondary-text bg-hover-bg rounded-full hover:text-primary-text hover:bg-hover-dark transition duration-200 focus:outline-none">
      <svg data-theme-toggle-target="moonIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
      <svg data-theme-toggle-target="sunIcon" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
    </button>

    <% if admin_signed_in? %>
      <%= button_to 'Logout', destroy_admin_session_path, method: :delete, class: 'px-4 py-2 bg-logout-button text-primary-text font-semibold rounded-xl hover:bg-logout-hover transition duration-200' %>
    <% elsif user_signed_in? %>
      <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: 'px-4 py-2 bg-logout-button text-primary-text font-semibold rounded-xl hover:bg-logout-hover transition duration-200' %>
    <% end %>
  </div>
</header>
