<%= turbo_frame_tag "modal" do %>
  <div id="modal" 
       data-controller="modal"
       data-action="click->modal#closeOnOutsideClick"
       class="fixed inset-0 z-50 overflow-y-auto backdrop-blur-md bg-black/50" 
       aria-labelledby="modal-title" 
       role="dialog" 
       aria-modal="true">
    <div class="flex items-start justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">

      <div class="inline-block align-bottom bg-primary-bg rounded-3xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full">
        <div class="p-6 lg:p-8 bg-card-bg">

          <div class="flex justify-end">
            <%= link_to "#", 
                data: { action: "modal#close" }, 
                class: "text-secondary-text hover:text-red-500 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            <% end %>
          </div>

          <div class="p-6 bg-secondary-bg rounded-xl shadow-md">
            <h1 class="text-2xl font-bold text-primary-text mb-4">Appointment Details</h1>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <p class="text-secondary-text font-semibold">Patient:</p>
                <p class="text-primary-text"><%= @appointment.patient.full_name %></p>
              </div>

              <div>
                <p class="text-secondary-text font-semibold">Doctor:</p>
                <p class="text-primary-text"><%= @appointment.doctor.full_name %></p>
              </div>

              <div>
                <p class="text-secondary-text font-semibold">Slot:</p>
                <p class="text-primary-text">
                  <% if @appointment.slot.present? %>
                    <%= @appointment.slot.start_time.strftime("%d %b %Y %I:%M %p") %> - 
                    <%= @appointment.slot.end_time.strftime("%I:%M %p") %>
                  <% else %>
                    Not Scheduled
                  <% end %>
                </p>
              </div>

              <div class="mt-2">
                <p class="text-secondary-text font-semibold">Status:</p>
                <p class="text-primary-text">
                  <%= manager_appointment_status_badge(@appointment.status) %>
                </p>
              </div>

              <div>
                <p class="text-secondary-text font-semibold">Created At:</p>
                <p class="text-primary-text"><%= @appointment.created_at.strftime("%d %b %Y %I:%M %p") %></p>
              </div>

              <div>
                <p class="text-secondary-text font-semibold">Updated At:</p>
                <p class="text-primary-text"><%= @appointment.updated_at.strftime("%d %b %Y %I:%M %p") %></p>
              </div>
            </div>

            <div class="mt-6">
              <button data-action="click->modal#close" class="bg-accent-1 hover:bg-accent-1-hover text-white px-4 py-2 rounded">
                Back
              </button>
              <%= link_to "Edit", edit_managers_appointment_path(@appointment), data: { turbo_frame: "modal" }, class: "bg-primary-accent hover:bg-primary-accent px-4 py-2 rounded text-white ml-2" %>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
<% end %>
