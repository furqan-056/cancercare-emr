<div class="p-6 lg:p-8">

  <div class="overflow-hidden mb-6">
    <div class="whitespace-nowrap animate-marquee text-secondary-text font-semibold">
      Check your email for updates on your requested appointments!
    </div>
  </div>

  <nav class="text-sm mb-6" aria-label="Breadcrumb">
    <ol class="list-none p-0 inline-flex">
      <li class="flex items-center">
        <%= link_to "Home", patients_dashboard_path, class: "text-blue-600 hover:text-blue-800" %>
        <span class="mx-2 text-gray-400">/</span>
      </li>
      <li class="flex items-center text-gray-500">
        Request Appointments
      </li>
    </ol>
  </nav>

  <h1 class="text-3xl font-bold mb-6 text-secondary-text">Request an Appointment</h1>

  <div class="mb-6">
    <%= search_form_for @q,
        url: patients_appointments_path,
        method: :get,
        html: { autocomplete: "off", data: { controller: "live-search", live_search_target: "form", turbo_frame: "doctors_results_frame" } } do |f| %>

      <div class="flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[250px]">
          <label class="block text-xs font-medium text-secondary-text mb-1 ml-1">
            Search Doctor
          </label>
          <%= f.search_field :first_name_or_last_name_cont,
                placeholder: "Search by doctor name...",
                class: "w-full rounded-xl border border-primary-border px-4 py-2 text-sm text-black bg-card-bg shadow focus:outline-none focus:ring-2 focus:ring-accent-1 text-secondary-text",
                autocomplete: "off",
                data: { action: "input->live-search#search" } %>
        </div>
      </div>
    <% end %>
  </div>

  <%= turbo_frame_tag "doctors_results_frame" do %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @doctors.each do |doctor| %>
        <% status = @appointments_by_doctor[doctor.id]&.to_s %>

        <div class="relative bg-card-bg rounded-2xl shadow-md p-6 flex flex-col hover:shadow-lg transition duration-200 ease-in-out">
          
          <div class="flex items-center justify-between mb-4">
            <div class="space-y-1">
              <h2 class="text-xl font-semibold text-secondary-text"><%= doctor.full_name %></h2>
              <p class="text-sm text-secondary-text"><strong>Phone:</strong> <%= doctor.phone %></p>
              <p class="text-sm text-secondary-text"><strong>Specialization:</strong> <%= doctor.specialization %></p>
              <p class="text-sm text-secondary-text"><strong>Department:</strong> <%= doctor.department %></p>
              <p class="text-sm text-secondary-text"><strong>Experience:</strong> <%= doctor.years_of_experience %> years</p>
              <p class="text-sm text-secondary-text"><strong>Availability:</strong> <%= doctor.availability %></p>
            </div>

            <div class="flex-shrink-0 ml-4">
              <% if doctor.profile_picture.attached? %>
                <%= image_tag doctor.profile_picture.variant(resize_to_fill: [80, 80]), class: "h-20 w-20 rounded-full object-cover border-2 border-primary-border" %>
              <% else %>
                <div class="h-20 w-20 rounded-full bg-gray-200 flex items-center justify-center text-xl font-bold text-gray-600 border-2 border-primary-border">
                  <%= doctor.first_name&.first&.upcase || "D" %>
                </div>
              <% end %>
            </div>
          </div>

          <%= appointment_status_badge(status, variant: :patient) %>

          <div id="request-btn-<%= doctor.id %>">
            <%= button_to "Request Appointment",
                  patients_appointments_path,
                  method: :post,
                  params: { doctor_id: doctor.id },
                  disabled: status.present?,
                  form: { data: { turbo_frame: "request-btn-#{doctor.id}" } },
                  class: "w-full py-2 px-4 rounded-xl bg-accent-1 text-white font-semibold hover:bg-accent-1-hover transition disabled:opacity-50 disabled:cursor-not-allowed" %>
          </div>

        </div>
      <% end %>
    </div>

    <div class="mt-6 flex justify-center">
      <%= paginate @doctors %>
    </div>
  <% end %>

</div>
