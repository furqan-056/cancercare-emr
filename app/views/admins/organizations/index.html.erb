<div class="p-4 sm:p-6 lg:p-8">
  <div class="sm:flex sm:items-center border-b border-primary-border pb-4 mb-6">
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-bold leading-tight tracking-tight text-secondary-text">My Organizations</h1>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <%= link_to "New Organization", new_admins_organization_path, class: "inline-flex items-center justify-center rounded-xl border border-transparent bg-accent-1 px-4 py-2 text-sm font-medium text-primary-text shadow-lg hover:bg-accent-1-hover focus:outline-none focus:ring-2 focus:ring-accent-1 focus:ring-offset-2 transition duration-200" %>
    </div>
  </div>

  <div class="mt-8 flow-root">
    <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
        <div class="overflow-hidden shadow-2xl ring-1 ring-primary-border ring-opacity-5 rounded-3xl">
          <table class="min-w-full divide-y divide-primary-border">
            <thead class="bg-card-bg border-b border-primary-border">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-secondary-text sm:pl-6">Logo</th>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-secondary-text">Name</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Email</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Type</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Phone</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Street</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Location</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">City</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Postal</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-secondary-text">Country</th>
                <th scope="col" class="py-3.5 pl-3 pr-4 sm:pr-6 text-sm font-semibold text-secondary-text text-center">Actions</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-primary-border bg-card-bg">
              <% @organizations.each do |org| %>
                <tr class="hover:bg-hover-dark/20 transition duration-150">
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-secondary-text sm:pl-6">
                    <% if org.logo.attached? %>
                      <%= image_tag org.logo.variant(resize_to_limit: [40, 40]), class: "h-10 w-10 rounded-full object-cover border border-primary-border" %>
                    <% else %>
                      <div class="h-10 w-10 rounded-full bg-secondary-bg/50 flex items-center justify-center text-xs text-secondary-text border border-primary-border">N/A</div>
                    <% end %>
                  </td>

                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-secondary-text sm:pl-6"><%= org.name %></td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-secondary-text"><%= org.email %></td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-secondary-text"><%= org.organization_type %></td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-secondary-text"><%= org.phone_number %></td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-secondary-text"><%= org.address&.street_address || "N/A" %></td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-secondary-text"><%= org.address&.location || "N/A" %></td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-secondary-text"><%= org.address&.city || "N/A" %></td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-secondary-text"><%= org.address&.postal_code || "N/A" %></td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-secondary-text"><%= org.address&.country || "N/A" %></td>

                  <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-sm font-medium sm:pr-6">
                    <div class="flex justify-center space-x-3">
                      <%= link_to admins_organization_path(org), class: "text-accent-1 hover:text-accent-1-hover", title: "Show" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" />
                        </svg>
                      <% end %>

                      <%= link_to edit_admins_organization_path(org), class: "text-accent-1 hover:text-accent-1-hover", title: "Edit" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                        </svg>
                      <% end %>

                      <%= link_to admins_organization_path(org), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-secondary-text hover:text-red-600 transition duration-150", title: "Delete" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="red">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" />
                        </svg>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
