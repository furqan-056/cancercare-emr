<div class="p-4 sm:p-6 lg:p-8">
  <div class="sm:flex sm:items-center sm:justify-between border-b border-gray-200 pb-4 mb-8">
    
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-bold leading-tight tracking-tight text-gray-900"><%= @organization.name %></h1>
    </div>

    <div class="mt-4 sm:ml-16 sm:mt-0 flex space-x-3">
      <%= link_to "Edit", edit_admins_organization_path(@organization), 
          class: "inline-flex items-center rounded-md border border-transparent bg-indigo-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
      <%= link_to "Back", admins_organizations_path, 
          class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    </div>

  </div>
  
  <div class="bg-white shadow overflow-hidden sm:rounded-lg mb-8">
    <div class="divide-y divide-gray-200">
      
      <div class="px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Organization Logo</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
          <% if @organization.logo.attached? %>
            <%= image_tag @organization.logo.variant(resize_to_limit: [300, 300]), class: "rounded-lg shadow-md max-w-full h-auto" %>
          <% else %>
            <span class="text-gray-500">No logo uploaded.</span>
          <% end %>
        </dd>
      </div>
      
      <div class="px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Email</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @organization.email %></dd>
      </div>
      
      <div class="px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Organization Type</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @organization.organization_type %></dd>
      </div>
      
      <div class="px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Phone Number</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @organization.phone_number %></dd>
      </div>

    </div>
  </div>
</div>
