<div id="modal"
    class="fixed inset-0 z-50 overflow-y-auto bg-opacity-50 backdrop-blur-md"
    role="dialog"
    aria-modal="true">

  <div class="flex items-start justify-center min-h-screen pt-4 px-4 pb-20 text-center">

    <div class="inline-block align-bottom bg-primary-bg rounded-3xl text-left shadow-xl max-w-lg w-full">

      <div class="p-6 bg-card-bg">

        <%= form_with model: patient, url: form_url, data: { turbo_frame: "modal" } do |f| %>

          <% if patient.errors.any? %>
            <div class="mb-4 p-4 border border-red-400 bg-red-50 text-red-700 rounded-md">
              <h2 class="font-bold mb-2">
                <%= pluralize(patient.errors.count, "error") %> prevented this patient from being saved:
              </h2>
              <ul class="list-disc list-inside">
                <% patient.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="flex justify-end mb-4">
            <a href="#"
              data-action="modals#close"
              class="text-secondary-text hover:text-red-500 transition">
              ✕
            </a>
          </div>

          <h3 class="text-xl font-semibold text-secondary-text mb-5">
            Patient Details
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :first_name, class: "block text-sm font-medium text-secondary-text" %>
              <%= f.text_field :first_name,
                              placeholder: "First Name",
                              class: "block w-full rounded-xl border border-primary-border p-3 bg-card-bg text-secondary-text" %>
            </div>

            <div>
              <%= f.label :last_name, class: "block text-sm font-medium text-secondary-text" %>
              <%= f.text_field :last_name,
                              placeholder: "Last Name",
                              class: "block w-full rounded-xl border border-primary-border p-3 bg-card-bg text-secondary-text" %>
            </div>

            <div>
              <%= f.label :phone, class: "block text-sm font-medium text-secondary-text" %>
              <%= f.text_field :phone,
                              placeholder: "555-123-4567",
                              class: "block w-full rounded-xl border border-primary-border p-3 bg-card-bg text-secondary-text" %>
            </div>

            <div>
              <%= f.label :email, class: "block text-sm font-medium text-secondary-text" %>
              <%= f.email_field :email,
                                placeholder: "patient@example.com",
                                class: "block w-full rounded-xl border border-primary-border p-3 bg-card-bg text-secondary-text" %>
            </div>

            <div class="md:col-span-2">
              <%= f.label :department, class: "block text-sm font-medium text-secondary-text" %>
              <%= f.text_field :department,
                              placeholder: "Oncology / Cardiology / etc.",
                              class: "block w-full rounded-xl border border-primary-border p-3 bg-card-bg text-secondary-text" %>
            </div>
          </div>

          <div class="pt-8">
            <%= f.submit patient.persisted? ? "Update Patient" : "Create Patient",
                        class: "rounded-xl bg-accent-1 py-3 px-6 text-sm font-semibold text-white hover:bg-accent-1-hover transition" %>
          </div>

        <% end %>

      </div>
    </div>
  </div>
</div>
