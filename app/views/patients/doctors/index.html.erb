<div class="max-w-7xl mx-auto px-4 py-8 bg-primary-bg transition-colors duration-300">
  <h1 class="text-3xl font-extrabold mb-6 text-primary-text tracking-tight border-b border-primary-border pb-4">
    Our Medical <span class="text-accent-1">Specialists</span>
  </h1>

  <div class="mb-6">
    <%= search_form_for @q, url: patients_doctors_path, method: :get, local: false, 
          html: { 
            data: { 
              controller: "live-search", 
              live_search_target: "form",
              turbo_frame: "doctors_list"
            }, 
            class: "flex gap-4 mb-8" 
          } do |f| %>

      <div class="flex-grow">
        <%= f.label :first_name_cont, "Search by First Name", class: "block text-sm font-medium text-primary-text mb-1" %>
        <%= f.search_field :first_name_cont, placeholder: "Enter doctor's first name", class: "w-50 border border-primary-border rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-accent-1 text-primary-text", 
               data: { action: "input->live-search#search" }, 
               autocomplete: "off",
               autofocus: true %>
      </div>
    <% end %>
  </div>

  <%= turbo_frame_tag "doctors_list" do %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% if @doctors.any? %>
        <% @doctors.each do |doctor| %>
          <div class="group bg-secondary-bg border border-primary-border rounded-2xl shadow-lg transition-all duration-300 overflow-hidden flex flex-col">
            <div class="h-2 bg-accent-1 w-full"></div>
            <div class="p-6 flex-grow">
              <div class="flex items-start gap-4 mb-4">
                <div class="w-16 h-16 rounded-full bg-hover-bg flex items-center justify-center text-black shrink-0 border border-primary-border">
                  <i class="fa-solid fa-user-doctor text-2xl"></i>
                </div>
                <div>
                  <h3 class="font-bold text-xl text-primary-text group-hover:text-accent-1 transition-colors">
                    Dr. <%= doctor.first_name %> <%= doctor.last_name %>
                  </h3>
                  <p class="text-accent-1 font-semibold text-sm uppercase tracking-wider">
                    <%= doctor.specialization || "General doctor" %>
                  </p>
                </div>
              </div>

              <div class="space-y-3 pt-4 border-t border-primary-border">
                <div class="flex items-center text-secondary-text text-sm">
                  <i class="fa-solid fa-hospital-user w-6 text-black opacity-80"></i>
                  <span class="font-medium mr-2">Dept:</span> 
                  <span class="text-primary-text"><%= doctor.department || "N/A" %></span>
                </div>
                <div class="flex items-center text-secondary-text text-sm">
                  <i class="fa-solid fa-briefcase w-6 text-black opacity-80"></i>
                  <span class="font-medium mr-2">Experience:</span> 
                  <span class="text-primary-text"><%= doctor.years_of_experience %> Years</span>
                </div>
              </div>
            </div>

            <div class="p-4 bg-hover-bg/20 border-t border-primary-border mt-auto">
              <%= link_to new_patients_doctor_appointment_path(doctor),
                  data: { turbo: false },
                  class: "w-full flex items-center justify-center gap-2 bg-accent-1 hover:bg-accent-1-hover text-white font-bold py-3 px-4 rounded-xl shadow-md transition-all transform active:scale-[0.95]" do %>
                <span>Book Appointment</span>
                <i class="fa-solid fa-calendar-check text-sm text-white"></i>
              <% end %>
            </div>

          </div>
        <% end %>
      <% else %>
        <div class="col-span-1 md:col-span-2 lg:col-span-3 text-center py-6 text-secondary-text text-sm">
          No doctors found.
        </div>
      <% end %>
    </div>

    <% if @doctors.respond_to?(:total_pages) && @doctors.total_pages > 1 %>
      <div class="mt-12 py-6 border-t border-primary-border flex justify-center">
        <div class="bg-secondary-bg p-2 rounded-xl border border-primary-border shadow-md">
          <%= paginate @doctors, params: { turbo_frame: "doctors_list" } %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
