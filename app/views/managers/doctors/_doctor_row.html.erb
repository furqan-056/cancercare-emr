<tr id="<%= dom_id(doctor) %>" class="hover:bg-secondary-bg/20 transition duration-150">
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text"><%= doctor.first_name %></td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text"><%= doctor.last_name %></td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text"><%= doctor.phone %></td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text"><%= doctor.specialization %></td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text"><%= doctor.department %></td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text"><%= doctor.years_of_experience %></td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text">Rs <%= number_with_precision(doctor.consultation_fee, precision: 2) %></td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text"><%= doctor.availability %></td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text"><%= doctor.email %></td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-secondary-text"><%= doctor.organization.name if doctor.organization.present? %></td>
  <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
    <div class="flex justify-end items-center space-x-3">
      
      <%= link_to managers_doctor_path(doctor), data: { turbo_frame: "modal" }, class: "text-accent-1 hover:text-accent-1-hover", title: "Show Doctor Details" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" />
        </svg>
      <% end %>

      <%= link_to edit_managers_doctor_path(doctor), title: "Edit Doctor", data: { turbo_frame: "modal" }, class: "text-accent-1 hover:text-accent-1-hover" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/>
        </svg>
      <% end %>
      
      <%= link_to managers_doctor_path(doctor),
                  method: :delete,
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to remove Dr. #{doctor.first_name}?" },
                  title: "Delete Doctor",
                  class: "text-red-600 hover:text-red-800" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z"/>
        </svg>
      <% end %>

    </div>
  </td>
</tr>
