<div class="p-6 lg:p-8">
  <div class="sm:flex sm:items-center border-b border-primary-border pb-4 mb-6">
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-bold tracking-tight text-secondary-text">Organizations</h1>
      <p class="mt-2 text-sm text-secondary-text">Manage all healthcare organizations.</p>
    </div>

    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <%= link_to "New Organization",
          new_admins_organization_path,
          data: { turbo_frame: "modal" },
          class: "block rounded-xl bg-accent-1 px-4 py-2 text-center text-sm font-semibold 
                  text-primary-text shadow hover:bg-accent-1-hover transition" %>
    </div>
  </div>

  <%= turbo_frame_tag "organizations_list" do %>
    <div class="overflow-x-auto rounded-xl border border-primary-border shadow">
      <table class="min-w-full divide-y divide-primary-border">
        <thead class="bg-secondary-bg">
          <tr>
            <th class="px-6 py-3 text-left text-sm font-semibold text-secondary-text">Logo</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-secondary-text">Name</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-secondary-text">Email</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-secondary-text">Type</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-secondary-text">Phone</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-secondary-text">Street Address</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-secondary-text">Location</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-secondary-text">City</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-secondary-text">Postal Code</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-secondary-text">Country</th>
            <th class="px-6 py-3 text-right text-sm font-semibold text-secondary-text">Actions</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-primary-border bg-card-bg">
          <% if @organizations.any? %>
            <% @organizations.each do |organization| %>
              <%= render partial: "organization", locals: { org: organization } %>
            <% end %>
          <% else %>
            <tr>
              <td colspan="11" class="text-center py-6 text-sm text-secondary-text">No organizations found.</td>
            </tr>
          <% end %>
        </tbody>

        <% if @organizations.total_pages > 1 %>
          <tfoot>
            <tr>
              <td colspan="11" class="py-4 px-6 bg-card-bg">
                <div class="flex justify-center" data-turbo-action="advance">
                  <%= paginate @organizations, params: { turbo_frame: "organizations_list" } %>
                </div>
              </td>
            </tr>
          </tfoot>
        <% end %>

      </table>
    </div>
  <% end %>

</div>
